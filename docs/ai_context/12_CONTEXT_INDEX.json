    "paired_grid_state_shape": "[n_pair, n_species, n_w]",
    "default_score": "sum_i M_ij |R_ij| / max(sum_i M_ij, 1)",
    "squared_score": "sum_i M_ij R_ij^2 / max(sum_i M_ij, 1)",
    "retain_rule": "retain point j if score_j > mean(score)",
    "causal_gate": "G(t; alpha, gamma) = (1 - tanh(alpha * (t_scaled - gamma))) / 2",
